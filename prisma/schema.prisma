generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 一次问卷发放（含当时场景说明），对应一个可分享的填写链接
model SurveyDistribution {
  id              String   @id @default(cuid())
  title           String
  /// 短摘要：列表与链接页标题旁展示
  scenarioSummary String
  /// 本次发放的场景说明（可较长，填写页顶部展示）
  scenarioDetail  String   @default("")
  /// URL 路径片段，唯一，如 /s/abc123
  slug            String   @unique
  /// 题库版本键，便于日后换题仍兼容分析
  templateKey     String   @default("interaction-literacy-v1")
  createdAt       DateTime @default(now())

  responses SurveyResponse[]
}

model SurveyResponse {
  id             String             @id @default(cuid())
  distributionId String
  distribution   SurveyDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  /// { [questionId]: number | string } — 与题库 question id 对齐
  answers        Json
  createdAt      DateTime           @default(now())

  @@index([distributionId])
}

/// 一次 DSE 中文诊断；accessToken 用于匿名续做，不代表登录身份
model DiagnosticAttempt {
  id            String    @id @default(cuid())
  accessToken   String    @unique
  templateKey   String    @default("dse-chinese-diagnostic-v1")
  status        String    @default("in_progress")
  currentModule String    @default("radio")
  displayScript String    @default("simplified")
  startedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  answers DiagnosticAnswer[]

  @@index([status])
  @@index([templateKey])
}

/// 每题保留首次答案与最终答案，用于区分不会、修正和提示后的改善
model DiagnosticAnswer {
  id              String            @id @default(cuid())
  attemptId       String
  attempt         DiagnosticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  firstAnswer     Json
  finalAnswer     Json
  firstResponseMs Int
  totalResponseMs Int
  hintLevel       Int               @default(0)
  revisionCount   Int               @default(0)
  score           Float
  dimensionScores Json
  answeredAt      DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}
