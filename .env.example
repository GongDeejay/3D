# 复制为 .env 后本地使用：`cp .env.example .env`

DATABASE_URL="file:./dev.db"

# 可选：管理后台「复制链接」与二维码使用的站点根地址（生产环境必设）
# 腾讯云标准化部署：https://3d.mplusm.site
# NEXT_PUBLIC_BASE_URL="https://3d.mplusm.site"

# 管理后台登录密码（请改为强密码）
ADMIN_PASSWORD="change-me-in-production"

# 用于签名管理会话 Cookie（随机长字符串）
SESSION_SECRET="replace-with-random-32-chars-min"
